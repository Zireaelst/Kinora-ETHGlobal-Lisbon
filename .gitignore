node_modules/
# `.env` alone would not cover .env.local, .env.backup-1786614683, or an
# editor's .env.save — all carrying the same secrets, none of them looking
# alarming in `git status`. Ignore the whole family, then re-admit the example.
.env
.env.*
!.env.example
dist/
*.log
.DS_Store

# Encrypted user data — never leaves the owner's machine
*.db
*.db-shm
*.db-wal

# Per-environment state: written by scripts/register-agents-hcs.ts against
# THIS environment's identity topic — a clone must register its own agents
agent-uaids.json
