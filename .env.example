# Copy to .env and fill in. .env is gitignored (.gitignore:2) — never commit it,
# and never paste its contents into a chat, an issue, or a commit message.
#
# Sections below are ordered by what a fresh clone needs first. Anything marked
# OPTIONAL has a working default and can be left blank.

# ─── Hedera agents (REQUIRED) ────────────────────────────────────────────────
# Two separate ECDSA testnet accounts from https://portal.hedera.com/dashboard.
# Separate accounts, not two keys on one — every payment in the demo is a real
# transfer between two distinct parties.
SELLER_ACCOUNT_ID=
SELLER_PRIVATE_KEY=
BUYER_ACCOUNT_ID=
BUYER_PRIVATE_KEY=

# ─── Policy parsing (REQUIRED) ───────────────────────────────────────────────
# Free, no card: https://console.groq.com/keys
GROQ_API_KEY=
# OPTIONAL — defaults to openai/gpt-oss-120b. Must support tool calling; the
# policy is extracted with structured output. Exists because Groq retires
# models: llama-3.3-70b-versatile, which this was built on, is gone.
GROQ_MODEL=

# ─── Off-chain catalogue (REQUIRED) ──────────────────────────────────────────
# Field-level AES-256-GCM key for the encrypted master references.
DATA_ENCRYPTION_KEY=
# OPTIONAL — sqlite file, defaults to ./catalogue.db
DATA_DB_PATH=

# ─── Hedera rail: x402 payments in HBAR (REQUIRED) ───────────────────────────
# blocky402 supports hedera:testnet and needs no signup.
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
# Where HBAR payments land — normally the same as SELLER_ACCOUNT_ID.
X402_PAY_TO_ACCOUNT=

# ─── HCS topics and the certificate collection (REQUIRED) ────────────────────
# Generated once by the scripts named beside each; paste the printed id back here.
HCS_AUDIT_TOPIC_ID=      # scripts/create-audit-topic.ts
HCS_IDENTITY_TOPIC_ID=   # scripts/create-identity-topic.ts
HTS_LICENCE_TOKEN_ID=    # scripts/create-licence-token.ts — "Music Licence Certificate" (MLIC)

# ─── X Layer rail: x402 payments in a stablecoin (OPTIONAL) ──────────────────
# A second settlement rail so a buyer agent holding no HBAR can still license a
# track. Identity, the audit trail and the certificate stay on Hedera — only
# where the money moves changes. Leave X402_XLAYER_RAIL unset to run Hedera-only;
# the 402 is then byte-for-byte what it was before this rail existed.
#
# "on" needs BOTH the payee below AND the three OKX credentials, or the rail
# stays off (the server logs which half is missing rather than failing to boot).
X402_XLAYER_RAIL=
# EVM address that receives X Layer payments. For the demo this is the OKX
# Agentic Wallet address — `onchainos wallet addresses` prints it.
X402_XLAYER_PAY_TO=

# OKX facilitator credentials — apply at https://web3.okx.com/onchainos/dev-portal
# NOTE: these are NOT protected by the Agentic Wallet's TEE. The TEE guards the
# buyer's signing key; these are seller-side API credentials and live in plain
# text here, so treat them like any other secret.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# OPTIONAL — facilitator host, defaults to https://web3.okx.com
OKX_BASE_URL=

# OPTIONAL — which stablecoin to quote on X Layer testnet.
#   unset / anything else → USDC_TEST 0xcb8bf24c6ce16ad21d707c9505421a17f2bec79d
#                           (what OKX's own mock merchant charges in)
#   usdt0                 → USD₮0    0x9e29b3aada05bf2d2c827af80bd28dc0b9b4fb0c
#                           (the default OKX's Go SDK declares)
# Both were verified on-chain — see ANALYSIS.md §11 and §12.
X402_XLAYER_ASSET=
# OPTIONAL — override the EIP-712 domain version. Only set this if OKX's
# facilitator rejects our signatures: the contract reports "2" and its
# DOMAIN_SEPARATOR agrees, but OKX's mock merchant advertises "1" (ANALYSIS.md
# §12.3). We publish the value the chain verifies; this is the escape hatch.
X402_XLAYER_EIP712_VERSION=
# OPTIONAL — HBAR→USD rate used to price the X Layer rail, defaults to 0.28.
# The catalogue prices in HBAR and the rail settles in a dollar stablecoin, so
# the two need a rate between them. Stated rather than implied; this is where a
# live feed would attach.
HBAR_USD_RATE=

# ─── Agent identity (OPTIONAL) ───────────────────────────────────────────────
# Normally read from agent-uaids.json, written by scripts/register-agents-hcs.ts.
# Set these only to point at agents registered elsewhere.
SELLER_UAID=
BUYER_UAID=
# Comma-separated UAIDs the seller will attest as compliant. Defaults to the
# registered buyer; widen it to admit additional buyer agents.
APPROVED_UAIDS=

# ─── Servers and endpoints (OPTIONAL) ────────────────────────────────────────
# Public base URL of the x402 licence server, baked into the payment
# instruction the seller hands out. Defaults to http://localhost:4021 — it MUST
# be set to a reachable https:// URL before the agent is listed anywhere public.
X402_BASE_URL=
# Demo panel port, defaults to 4100.
WEB_PORT=
# Mirror node, defaults to https://testnet.mirrornode.hedera.com
HEDERA_MIRROR_NODE_URL=

# ─── Demo content (OPTIONAL) ─────────────────────────────────────────────────
# Overrides the rights holder's plain-language policy. The panel's form sets
# this at runtime instead; use it to change the rules without touching code.
POLICY_STATEMENT=
